# Copy to .env with `make setup`. Local development only; setup replaces the secrets.
POSTGRES_DB=rivalry_court
POSTGRES_USER=rivalry
POSTGRES_PASSWORD=change-me
# Used by GoTrue to sign access tokens and by the API to verify them (32+ characters).
AUTH_JWT_SECRET=replace-with-a-long-random-secret
# Browser URL for the React app and magic-link redirect destination.
WEB_URL=http://localhost:5173
# Public URL of the local GoTrue auth service, accessed directly by the browser.
AUTH_URL=http://localhost:9999
# Browser URL for the FastAPI service.
API_URL=http://localhost:8001
# Host port for the API; container port remains 8000.
API_PORT=8001
# SMTP sender for local magic links and score notifications.
MAIL_FROM=Rivalry Court <no-reply@rivalry.local>
# SMTP host and port reachable from the API and GoTrue containers.
SMTP_HOST=mailpit
SMTP_PORT=1025
# Set true for real providers (Brevo etc.); Mailpit locally does not use encryption.
SMTP_STARTTLS=false
# Optional SMTP credentials; Mailpit requires none locally.
SMTP_USER=
SMTP_PASSWORD=
# Database URL used by the API and Alembic inside Compose.
DATABASE_URL=postgresql+psycopg://rivalry:change-me@db:5432/rivalry_court
# Use production to reject placeholder secrets and non-HTTPS web URLs.
APP_ENV=development
